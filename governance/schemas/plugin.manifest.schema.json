{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XLP Audio Plugin Manifest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "brand",
    "layer",
    "category",
    "version",
    "api_version",
    "abi_version",
    "stability",
    "description",
    "plugin_code",
    "vst3_component_uid",
    "vst3_controller_uid",
    "formats",
    "channel_layouts",
    "dependencies",
    "state_schema_version",
    "migration_strategy",
    "params_file",
    "extension_points",
    "realtime_contract",
    "performance_budget",
    "modding",
    "research_refs",
    "adr_refs",
    "testing",
    "docs"
  ],
  "properties": {
    "schema_version": { "type": "string", "format": "semver" },
    "id": { "type": "string", "pattern": "^xlp\\.[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 3 },
    "brand": { "type": "string", "const": "xlp" },
    "layer": { "type": "string", "const": "plugins" },
    "category": {
      "type": "string",
      "enum": ["effect", "instrument", "utility", "analyzer", "midi_fx", "modular_rack"]
    },
    "version": { "type": "string", "format": "semver" },
    "api_version": { "type": "string", "format": "semver" },
    "abi_version": { "type": "integer", "minimum": 1 },
    "stability": { "type": "string", "enum": ["experimental", "beta", "stable"] },
    "description": { "type": "string", "minLength": 20 },
    "plugin_code": { "type": "string", "pattern": "^[A-Za-z0-9]{4}$" },
    "vst3_component_uid": { "type": "string", "format": "uuid" },
    "vst3_controller_uid": { "type": "string", "format": "uuid" },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["vst3", "clap", "au", "lv2", "standalone"] }
    },
    "channel_layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inputs", "outputs"],
        "properties": {
          "inputs": { "type": "integer", "minimum": 0, "maximum": 64 },
          "outputs": { "type": "integer", "minimum": 1, "maximum": 64 },
          "sidechain": { "type": "boolean" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^xlp\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" }
    },
    "state_schema_version": { "type": "integer", "minimum": 1 },
    "migration_strategy": { "type": "string", "minLength": 15 },
    "params_file": { "type": "string", "minLength": 1 },
    "extension_points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "interface", "version", "lifecycle", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
          "interface": { "type": "string", "minLength": 2 },
          "version": { "type": "string", "format": "semver" },
          "lifecycle": { "type": "string", "enum": ["init", "runtime", "hot_reload", "compile_time"] },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "realtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_thread_lock_free",
        "audio_thread_alloc_free",
        "denormal_protection",
        "supported_sample_rates",
        "arbitrary_block_sizes",
        "thread_communication"
      ],
      "properties": {
        "audio_thread_lock_free": { "type": "boolean" },
        "audio_thread_alloc_free": { "type": "boolean" },
        "denormal_protection": { "type": "boolean" },
        "supported_sample_rates": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 8000 }
        },
        "arbitrary_block_sizes": { "type": "boolean" },
        "thread_communication": { "type": "string", "minLength": 3 }
      }
    },
    "performance_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cpu_percent_single_core_48k_64buf",
        "max_memory_mb",
        "max_latency_samples",
        "benchmark_target"
      ],
      "properties": {
        "max_cpu_percent_single_core_48k_64buf": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "max_memory_mb": { "type": "number", "exclusiveMinimum": 0 },
        "max_latency_samples": { "type": "integer", "minimum": 0 },
        "benchmark_target": { "type": "string", "minLength": 3 }
      }
    },
    "modding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mod_api_version",
        "hot_reload_supported",
        "conflict_resolution",
        "reference_mod_path",
        "surfaces"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mod_api_version": { "type": "string", "format": "semver" },
        "hot_reload_supported": { "type": "boolean" },
        "conflict_resolution": { "type": "string", "minLength": 3 },
        "reference_mod_path": { "type": "string", "minLength": 3 },
        "surfaces": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "sandbox_level",
              "allow_filesystem",
              "allow_network",
              "rt_safe_enforced",
              "cpu_budget_us",
              "memory_limit_kb",
              "fallback_on_error"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
              "kind": {
                "type": "string",
                "enum": [
                  "themes",
                  "presets",
                  "macros",
                  "dsp_graph",
                  "scripts",
                  "wavetables",
                  "impulse_responses",
                  "modulation_curves",
                  "tunings"
                ]
              },
              "sandbox_level": { "type": "string", "enum": ["declarative_schema", "lua_sandbox", "wasm_sandbox"] },
              "allow_filesystem": { "type": "boolean", "const": false },
              "allow_network": { "type": "boolean", "const": false },
              "rt_safe_enforced": { "type": "boolean" },
              "cpu_budget_us": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "memory_limit_kb": { "type": "integer", "minimum": 16, "maximum": 65536 },
              "fallback_on_error": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "research_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^RES-[0-9]{4}$" }
    },
    "adr_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "command", "categories"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 3 },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme", "architecture", "api", "testing", "modding"],
      "properties": {
        "readme": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "api": { "type": "string", "minLength": 1 },
        "testing": { "type": "string", "minLength": 1 },
        "modding": { "type": "string", "minLength": 1 }
      }
    }
  }
}
