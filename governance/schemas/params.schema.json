{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XLP Plugin Parameter Declaration Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "state_schema_version", "parameters"],
  "properties": {
    "schema_version": { "type": "string", "format": "semver" },
    "plugin_id": { "type": "string", "pattern": "^xlp\\.[a-z][a-z0-9_]*$" },
    "state_schema_version": { "type": "integer", "minimum": 1 },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uid",
          "name",
          "type",
          "min",
          "max",
          "default",
          "unit",
          "automatable",
          "modulatable",
          "description"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
          "uid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "name": { "type": "string", "minLength": 2 },
          "type": { "type": "string", "enum": ["float", "int", "bool", "choice"] },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "default": { "type": "number" },
          "unit": { "type": "string" },
          "automatable": { "type": "boolean" },
          "modulatable": { "type": "boolean" },
          "smoothing_ms": { "type": "number", "minimum": 0, "maximum": 5000 },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
