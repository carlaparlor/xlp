{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XLP Audited Waivers Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "waivers"],
  "properties": {
    "schema_version": { "type": "string", "format": "semver" },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_id",
          "target_path",
          "adr_id",
          "justification",
          "created_on",
          "expires_on",
          "owner"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^WAV-[0-9]{4}$" },
          "rule_id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" },
          "target_path": { "type": "string", "minLength": 1 },
          "adr_id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
          "justification": { "type": "string", "minLength": 40 },
          "created_on": { "type": "string", "format": "date" },
          "expires_on": { "type": "string", "format": "date" },
          "owner": { "type": "string", "minLength": 2 }
        }
      }
    }
  }
}
