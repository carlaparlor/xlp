{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XLP Rule Traceability Matrix Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": { "type": "string", "format": "semver" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "domain",
          "adr_ids",
          "research_ids",
          "check_module",
          "doc_anchor",
          "positive_tests",
          "adversarial_tests"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" },
          "domain": {
            "type": "string",
            "enum": [
              "brand",
              "modularity",
              "scalability",
              "extensibility",
              "moddability",
              "research",
              "testing",
              "documentation",
              "governance"
            ]
          },
          "adr_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" }
          },
          "research_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^RES-[0-9]{4}$" }
          },
          "check_module": { "type": "string", "minLength": 3 },
          "doc_anchor": { "type": "string", "pattern": "^[a-z]{3}-[0-9]{3}$" },
          "positive_tests": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "adversarial_tests": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          }
        }
      }
    }
  }
}
